{
	"$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
	"productName": "ReinaManagerCEFPreview",
	"mainBinaryName": "ReinaManagerCEFPreview",
	"version": "../package.json",
	"identifier": "com.reinamanager.cef-preview",
	"build": {
		"frontendDist": "../dist",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": "pnpm dev",
		"beforeBuildCommand": "pnpm build"
	},
	"app": {
		"withGlobalTauri": false,
		"windows": [
			{
				"create": false,
				"title": "ReinaManager CEF Preview",
				"width": 1200,
				"height": 740,
				"minWidth": 1024,
				"minHeight": 662,
				"resizable": true,
				"fullscreen": false,
				"dragDropEnabled": true,
				"visible": false,
				"zoomHotkeysEnabled": true
			}
		],
		"security": {
			"csp": null,
			"assetProtocol": {
				"enable": true,
				"scope": [
					"**"
				]
			}
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"resources": {
			"target/7zip/": "tools/7zip"
		},
		"createUpdaterArtifacts": false,
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		],
		"copyright": "Copyright © 2025 huoshen80",
		"publisher": "huoshen80",
		"windows": {
			"wix": {
				"fragmentPaths": [
					"windows/update-path.wxs"
				],
				"componentGroupRefs": [
					"ReinaUpdatePath"
				]
			},
			"nsis": {
				"template": "windows/installer.nsi",
				"installerHooks": "windows/installer-hooks.nsh",
				"installerIcon": "icons/icon.ico",
				"languages": [
					"English",
					"SimpChinese",
					"TradChinese",
					"Japanese"
				],
				"displayLanguageSelector": true
			}
		}
	},
	"plugins": {}
}
